# Safe example defaults for an isolated two-VM lab.
# Copy this file to config.env and edit it for your own authorized environment.

export IFACE="${IFACE:-ens18}"
export TARGET_IP="${TARGET_IP:-192.168.56.20}"
export HTTP_PORT="${HTTP_PORT:-8080}"
export TARGET_URL="${TARGET_URL:-http://${TARGET_IP}:${HTTP_PORT}}"
export KALI_IP="${KALI_IP:-192.168.56.10}"
export KALI_URL="${KALI_URL:-http://${KALI_IP}}"
export DNS_SERVER="${DNS_SERVER:-${TARGET_IP}}"

export EDGE_CROSSVAL_ROOT="${EDGE_CROSSVAL_ROOT:-data/edge_crossval}"
export EDGE_RAW_DIR="${EDGE_RAW_DIR:-${EDGE_CROSSVAL_ROOT}/raw}"
export EDGE_CSV_DIR="${EDGE_CSV_DIR:-${EDGE_CROSSVAL_ROOT}/csv}"

# Safety guard. Keep 0 for lab use; set to 1 only for an explicitly authorized non-private target.
export ALLOW_NON_PRIVATE="${ALLOW_NON_PRIVATE:-0}"

# Optional service endpoints for specific generators.
export SSH_USER="${SSH_USER:-root}"
export SSH_PORT="${SSH_PORT:-22}"
export CANONICAL_SSH_PORT="${CANONICAL_SSH_PORT:-22}"
export HTTP_LOGIN_PATH="${HTTP_LOGIN_PATH:-/login}"
export HTTP_LOGIN_FAIL_TEXT="${HTTP_LOGIN_FAIL_TEXT:-Invalid}"
export MQTT_HOST="${MQTT_HOST:-${TARGET_IP}}"
export MQTT_TOPIC_PREFIX="${MQTT_TOPIC_PREFIX:-sensors}"

# Capture runner defaults. The overnight capture scripts now write PCAP files
# only; extraction and final CSV building are run later.
export MAX_ROUNDS="${MAX_ROUNDS:-14}"
export CAPTURE_CLASSES="${CAPTURE_CLASSES:-normal dos_ddos injection password scanning backdoor}"
export SKIP_EXISTING_PCAPS="${SKIP_EXISTING_PCAPS:-1}"

# Offline extraction/build defaults. Zeek is preferred for the new retraining
# dataset because it creates stable flow/protocol rows from PCAPs.
export TARGET_PER_CLASS="${TARGET_PER_CLASS:-60000}"
export LIMIT_PER_PCAP="${LIMIT_PER_PCAP:-30000}"
export BUILD_DISTRIBUTION="${BUILD_DISTRIBUTION:-balanced}"
export PCAP_PARSER="${PCAP_PARSER:-zeek}"
export ZEEK_BIN="${ZEEK_BIN:-zeek}"
export ENABLE_MQTT="${ENABLE_MQTT:-0}"
export ENABLE_HTTP_PASSWORD="${ENABLE_HTTP_PASSWORD:-1}"
export START_LOCAL_C2="${START_LOCAL_C2:-0}"
export C2_PORT="${C2_PORT:-8090}"
export C2_URL="${C2_URL:-http://${TARGET_IP}:${C2_PORT}}"

# Debian-side remote control of the Kali generator.
export KALI_SSH_USER="${KALI_SSH_USER:-kali}"
export KALI_SSH_PORT="${KALI_SSH_PORT:-22}"
export KALI_LAB_DIR="${KALI_LAB_DIR:-~/edge_crossval_lab}"
export SSH_BATCH_MODE="${SSH_BATCH_MODE:-yes}"
