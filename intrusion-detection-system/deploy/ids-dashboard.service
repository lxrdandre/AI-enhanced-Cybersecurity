[Unit]
Description=TON IoT IDS Live Dashboard (Flask)
After=network.target ids-api.service
Wants=ids-api.service

[Service]
Type=simple
User=ton-iot
WorkingDirectory=/opt/ton-iot-ips
Environment="PATH=/opt/ton-iot-ips/.venv/bin:/usr/local/bin:/usr/bin"
Environment="TON_IOT_PROJECT_ROOT=/opt/ton-iot-ips"
Environment="TON_IOT_DASHBOARD_HOST=0.0.0.0"
Environment="TON_IOT_DASHBOARD_PORT=5000"
Environment="TON_IOT_DASHBOARD_API_URL=http://127.0.0.1:8000"
Environment="TON_IOT_DASHBOARD_LOG_DIR=/opt/ton-iot-ips/logs"
Environment="TON_IOT_DASHBOARD_THREAT_DB=/opt/ton-iot-ips/data/threat_cache.db"
Environment="TON_IOT_DASHBOARD_PROTECTED_IPS=192.168.56.20"
Environment="TON_IOT_DASHBOARD_PROTECTED_IPS_FILE=/opt/ton-iot-ips/data/protected_ips.json"
Environment="TON_IOT_DASHBOARD_FIREWALL_QUEUE=/opt/ton-iot-ips/data/firewall_requests.json"
EnvironmentFile=-/opt/ton-iot-ips/.env
ExecStart=/opt/ton-iot-ips/.venv/bin/python -m dashboard.app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ids-dashboard

[Install]
WantedBy=multi-user.target
